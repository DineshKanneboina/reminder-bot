{
  "name": "reminder-bot",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc",
    "db:init": "wrangler d1 execute reminder-bot --remote --file=./schema.sql",
